# Pinger Environment Variables

# Frontend & General
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="pingr.site"
CNAME_TARGET="cname.pingr.site"
NODE_ENV="development"

# Vercel Integration (Server-only for custom domain attachment and SSL provisioning)
VERCEL_AUTH_TOKEN="your_vercel_bearer_token"
VERCEL_PROJECT_ID="your_vercel_project_id"
VERCEL_TEAM_ID="your_vercel_team_id"

# Database
# Use the direct connection string for the worker and Drizzle ORM
DATABASE_URL="postgres://postgres:password@localhost:5432/postgres"

# Supabase (Optional, if using their client for some specific reason, but we mostly use raw DB connection)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Keep this secret - used for backend admin tasks if Supabase client is used
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Authentication
# Secret used to sign session cookies/tokens
SESSION_SECRET="generate-a-strong-random-secret-here-at-least-32-chars"

# Encryption (Used to encrypt sensitive monitor credentials)
# Must be exactly 32 bytes (256 bits) for AES-256-GCM, hex encoded.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Email Configuration
EMAIL_FROM="Pingr <noreply@pingr.site>"

# 1. Primary OTP Provider (Resend)
RESEND_API_KEY="re_..."

# 2. Monitor Incidents & Warnings Provider (Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_ALERTS_USER="alerts@yourdomain.com"
GMAIL_ALERTS_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# 3. Fallback OTP Provider (Gmail)
# Used automatically if Resend fails or runs out of quota
GMAIL_OTP_USER="auth@yourdomain.com"
GMAIL_OTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Plan IDs
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_BUSINESS_PRICE_ID="price_..."

# Worker Configuration
WORKER_BATCH_SIZE="20"
WORKER_TRIGGER_SECRET="your_long_secure_random_string"
